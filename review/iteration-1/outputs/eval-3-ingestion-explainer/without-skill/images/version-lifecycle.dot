// Version lifecycle: the four Catalog statuses and who sets them.
// Hand-placed layout (neato with pinned positions, units = inches).
// Regenerate:  neato -Tpng -Gdpi=150 version-lifecycle.dot -o version-lifecycle.png
//
// Step numbers match "The pipeline, stage by stage" in the explainer.
// The DLQ box is not a status: it holds messages, not Versions.

digraph lifecycle {
  layout=neato;
  graph [splines=line, fontname="Arial", pad=0.25, bgcolor="white", outputorder=edgesfirst];
  node  [fontname="Arial", fontsize=14, shape=box, style="rounded,filled", penwidth=1.5,
         margin="0.22,0.12", color="#44546A", fillcolor="#FFFFFF"];
  edge  [fontname="Arial", fontsize=12, color="#44546A", fontcolor="#222222", arrowsize=0.9, penwidth=1.5];

  start [pos="0,0!", label="", shape=circle, width=0.25, fixedsize=true, style=filled, fillcolor="#44546A"];

  received    [pos="0,-1.3!",  fillcolor="#DAE8FC", color="#3B6FB6",
               label=<<B>received</B><BR/><FONT POINT-SIZE="11">set by the Uploader API (step 4)</FONT>>];
  validated   [pos="0,-3.6!",  fillcolor="#DAE8FC", color="#3B6FB6",
               label=<<B>validated</B><BR/><FONT POINT-SIZE="11">set by the Validation Worker (step 7a)</FONT>>];
  published   [pos="0,-5.9!",  fillcolor="#D5ECD4", color="#4E8F4B",
               label=<<B>published</B><BR/><FONT POINT-SIZE="11">set by the Transform Worker (step 9)</FONT>>];
  quarantined [pos="5.4,-1.3!", fillcolor="#FDE2E0", color="#C0392B",
               label=<<B>quarantined</B><BR/><FONT POINT-SIZE="11">set by the Validation Worker (step 7b)</FONT>>];

  dlq [pos="5.4,-5.2!", style="rounded,dashed", color="#C0392B", fontsize=12,
       label=<<B>Dead-letter queue (DLQ)</B><BR/>holds <I>messages</I>, not Versions<BR/>pages on-call · runbook <FONT FACE="Courier New">replay-dlq</FONT>>];

  // vertical arrows: labels sit to the left of the line
  start     -> received;
  received  -> validated [label=<file passes the<BR/>Schema contract     >];
  validated -> published [label=<tables written,<BR/>Lineage record added     >];

  // the label for the horizontal red arrow is a pinned text node so it sits clear of the arrowhead
  qlabel [pos="2.6,-0.85!", shape=plain, style="", label=<<FONT COLOR="#B03024" POINT-SIZE="12">file fails the<BR/>Schema contract</FONT>>];
  received -> quarantined [color="#C0392B"];

  received  -> dlq [style=dashed, color="#C0392B",
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="white"><TR><TD><FONT COLOR="#B03024"><I>validate message:<BR/>attempts used up</I></FONT></TD></TR></TABLE>>];
  validated -> dlq [style=dashed, color="#C0392B",
      label=<<TABLE BORDER="0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1" BGCOLOR="white"><TR><TD><FONT COLOR="#B03024"><I>transform message:<BR/>attempts used up</I></FONT></TD></TR></TABLE>>];
}
