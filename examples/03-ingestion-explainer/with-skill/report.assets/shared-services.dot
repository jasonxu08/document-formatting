digraph shared_services {
  rankdir=LR; pad=0.3; nodesep=0.4; ranksep=2.3; bgcolor="white";
  graph [fontname="Arial"];
  node [shape=box, style="rounded,filled", fillcolor="#F2F4F7", color="#98A2B3",
        fontname="Arial", fontsize=15, margin="0.18,0.10"];
  edge [color="#667085", fontname="Arial", fontsize=13, arrowsize=0.9];

  "Uploader API";
  "Validation Worker";
  "Transform Worker";
  "Catalog";
  "Curated Zone"      [label="Curated Zone", shape=cylinder];
  "Policy Engine"     [label="Policy Engine\nmay this user or tenant\ndo X on dataset Y?", fillcolor="#D1E9FF", color="#175CD3", penwidth=2.5];
  "Raw Zone"          [label="Raw Zone\nkept 1 year", shape=cylinder];
  "Schema Registry"   [label="Schema Registry\nversioned contracts"];
  "Notifier"          [label="Notifier\nemails and webhooks"];

  "Uploader API" -> "Policy Engine"  [label="may this tenant\nupload here?", color="#175CD3", fontcolor="#175CD3"];
  "Catalog"      -> "Policy Engine"  [label="who may see\na dataset?", color="#175CD3", fontcolor="#175CD3"];
  "Curated Zone" -> "Policy Engine"  [label="row-level rules", color="#175CD3", fontcolor="#175CD3"];
  "Uploader API"      -> "Raw Zone"  [label="streams file in"];
  "Validation Worker" -> "Raw Zone"  [label="reads file"];
  "Transform Worker"  -> "Raw Zone"  [label="reads file"];
  "Validation Worker" -> "Schema Registry" [label="fetches contract"];
  "Validation Worker" -> "Notifier"  [label="on quarantine"];
  "Transform Worker"  -> "Notifier"  [label="on publish"];
}
